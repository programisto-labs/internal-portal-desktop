{
  "name": "lasco-desktop",
  "version": "2.11.0",
  "description": "Lasco — desktop app for the Lasco web platform (my.programisto.fr)",
  "main": "src/main.js",
  "private": true,
  "author": "Lasco / Programisto <tech@programisto.fr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/programisto-labs/internal-portal-desktop.git"
  },
  "scripts": {
    "icons:pad": "node scripts/pad-dock-icon.js",
    "icons:tray": "node scripts/make-tray-icons.js",
    "prebuild": "node scripts/pad-dock-icon.js",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "env -u ELECTRON_RUN_AS_NODE NODE_ENV=development electron .",
    "postinstall": "node scripts/fix-node-pty.js",
    "build": "electron-builder",
    "build:mac": "node scripts/pad-dock-icon.js && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "build:mac:signed": "node scripts/pad-dock-icon.js && CSC_IDENTITY_AUTO_DISCOVERY=true electron-builder --mac",
    "build:mac:signed:keychain": "node scripts/pad-dock-icon.js && CSC_IDENTITY_AUTO_DISCOVERY=true CSC_KEYCHAIN=$HOME/Library/Keychains/login.keychain-db electron-builder --mac",
    "build:mac:dmg": "node scripts/pad-dock-icon.js && CSC_IDENTITY_AUTO_DISCOVERY=true CSC_KEYCHAIN=$HOME/Library/Keychains/login.keychain-db CSC_NAME='Programisto (48UZ7QZ7W5)' electron-builder --mac dmg",
    "build:mac:p12": "node scripts/pad-dock-icon.js && CSC_LINK=\"$(pwd)/Certificates.p12\" electron-builder --mac",
    "test:quarantine": "bash scripts/test-quarantine.sh",
    "test:unit": "node --test scripts/test-browser-url.js scripts/test-browser-external-apps.js scripts/test-default-browser.js scripts/test-browser-manager.js scripts/test-shell-shortcuts.js scripts/test-chrome-identity.js scripts/test-browser-history.js scripts/test-search-engines.js scripts/test-browser-passwords.js scripts/test-form-autofill.js scripts/test-vault-auth.js scripts/test-link-handling.js scripts/test-agent-notifications.js scripts/test-tab-menu.js scripts/test-tab-windows.js scripts/test-app-menu.js scripts/test-tray-state.js scripts/test-background-mode.js scripts/test-tray-platform.js scripts/test-tray-badge.js scripts/test-login-item.js scripts/test-host-ops.js scripts/test-host-shell.js scripts/test-host-web-settings.js scripts/test-inline-confirm.js scripts/test-code-harness.js scripts/test-code-workspace.js scripts/test-media-permissions.js scripts/test-drive-sync.js scripts/test-downloads.js scripts/test-site-permissions.js scripts/test-page-errors.js scripts/test-vm-mode.js scripts/test-forced-update.js scripts/test-agent-tabs.js scripts/test-responsive.js",
    "debug:signing": "bash scripts/debug-signing.sh",
    "fix:quarantine": "bash scripts/fix-quarantine.sh",
    "install:mac": "bash scripts/install-lasco-macos.sh",
    "build:mac:internal": "bash scripts/build-and-package.sh",
    "build:win": "node scripts/pad-dock-icon.js && electron-builder --win",
    "build:linux": "node scripts/pad-dock-icon.js && electron-builder --linux",
    "publish:mac": "node scripts/pad-dock-icon.js && electron-builder --mac --publish always -c.forceCodeSigning=true",
    "publish:win": "node scripts/pad-dock-icon.js && electron-builder --win --publish always",
    "publish:linux": "node scripts/pad-dock-icon.js && electron-builder --linux --publish always",
    "publish:all": "node scripts/pad-dock-icon.js && electron-builder --mac --win --publish always"
  },
  "devDependencies": {
    "@electron/osx-sign": "^2.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^25.0.0",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "fr.lasco.desktop",
    "productName": "Lasco",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/lasco-icon-transparent.png",
      "build/tray/*.png"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Lasco utilise le micro pour la voix de vos agents et pour les sites que vous y autorisez (visioconférences…).",
        "NSCameraUsageDescription": "Lasco utilise la caméra pour les sites que vous y autorisez (visioconférences…).",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web site URL",
            "CFBundleURLSchemes": [
              "http",
              "https"
            ],
            "CFBundleTypeRole": "Viewer"
          },
          {
            "CFBundleURLName": "Lasco link",
            "CFBundleURLSchemes": [
              "lasco"
            ],
            "CFBundleTypeRole": "Viewer"
          }
        ]
      },
      "notarize": true
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "programisto-labs",
        "repo": "internal-portal-desktop",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "src/browser-tabs/devtools-extension/**"
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "node-pty": "^1.1.0"
  }
}
